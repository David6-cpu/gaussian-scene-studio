    "@types/pngjs": "6.0.5",
    "@types/three": "0.186.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "4.1.11"
  }
